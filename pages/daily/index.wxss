.container {
  padding: 0;
  background: #fff;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  width: 100%;
  box-sizing: border-box;
  padding-top: constant(safe-area-inset-top);
  padding-top: env(safe-area-inset-top);
}

.header {
  padding: 5rpx 0 0;
  background: #fff;
  width: 100%;
  box-sizing: border-box;
  position: fixed;
  top: env(safe-area-inset-top);
  left: 0;
  z-index: 100;
}

.date-picker {
  background: #fff;
  padding: 5rpx 40rpx 0;
  text-align: center;
  font-size: 32rpx;
  color: #333;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  box-sizing: border-box;
}

.date-text {
  background: #f5f5f5;
  padding: 8rpx 30rpx;
  border-radius: 30rpx;
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
  min-width: 240rpx;
  text-align: center;
}

.income-card {
  margin-top: 80rpx;
  background: linear-gradient(135deg, #1AAD19 0%, #2DC62B 100%);
  padding: 40rpx 40rpx;
  color: #fff;
  box-shadow: 0 4rpx 20rpx rgba(26, 173, 25, 0.2);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  width: 100%;
}

.income-title {
  font-size: 32rpx;
  opacity: 0.9;
  margin-bottom: 20rpx;
}

.income-amount {
  font-size: 88rpx;
  font-weight: bold;
  margin: 0;
  line-height: 1;
}

.input-form {
  background: #fff;
  padding: 20rpx 40rpx 10rpx;
  margin-top: 0;
  width: 100%;
  box-sizing: border-box;
}

.form-title {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 20rpx;
  font-weight: bold;
}

.form-item {
  margin-bottom: 15rpx;
}

.input-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
  display: block;
}

.amount-input,
.desc-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #eee;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: #f8f8f8;
}

.submit-btn {
  background: #1AAD19;
  color: #fff;
  border: none;
  margin: 5rpx auto;
  height: 70rpx;
  width: 180rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  border-radius: 35rpx;
}

.submit-btn:active {
  opacity: 0.8;
}

.cancel-btn {
  background: #f5f5f5;
  color: #666;
  border: none;
  margin: 10rpx auto;
  height: 70rpx;
  width: 180rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  border-radius: 35rpx;
}

.cancel-btn:active {
  opacity: 0.8;
}

.income-list {
  background: #fff;
  padding: 30rpx 0 0 0;
  margin-top: 0;
  width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  flex: 1;
  position: relative;
  height: calc(100vh - 280rpx);
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 40rpx 20rpx 40rpx;
  border-bottom: 1rpx solid #eee;
  position: relative;
  z-index: 2;
  background: #fff;
  margin-bottom: 15rpx;
}

.list-title {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
}

.list-count {
  font-size: 24rpx;
  color: #999;
}

.list-scroll {
  flex: 1;
  position: absolute;
  top: 70rpx;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  z-index: 1;
}

.income-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 40rpx;
  border-bottom: 1rpx solid #eee;
  background: #fff;
  transition: all 0.3s;
  width: 100%;
  margin-top: 8rpx;
  box-sizing: border-box;
}

.income-item:active {
  background: #f8f8f8;
}

.item-left {
  flex: 1;
}

.item-time {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.item-desc {
  font-size: 24rpx;
  color: #999;
}

.item-right {
  text-align: right;
}

.item-amount {
  font-size: 32rpx;
  color: #1AAD19;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.item-delete {
  font-size: 24rpx;
  color: #ff4d4f;
  padding: 4rpx 0;
}

.empty-tip {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 60rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.floating-button {
  position: fixed;
  right: 40rpx;
  bottom: calc(env(safe-area-inset-bottom) + 140rpx);
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #1AAD19 0%, #2DC62B 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(26, 173, 25, 0.3);
  z-index: 100;
  touch-action: none;
  transition: none;
}

.floating-button::before {
  content: '+';
  color: #fff;
  font-size: 60rpx;
  font-weight: 300;
  line-height: 1;
}

.floating-button:active {
  transform: scale(0.95);
  opacity: 0.9;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 600rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: visible;
  animation: modalIn 0.3s ease;
  position: relative;
}

@keyframes modalIn {
  from {
    transform: scale(0.8);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}

.modal-header {
  padding: 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #eee;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
  line-height: 1;
  padding: 10rpx;
}

.modal-body {
  padding: 30rpx;
  position: relative;
  z-index: 1002;
}

.modal-footer {
  padding: 20rpx 30rpx;
  display: flex;
  justify-content: flex-end;
  border-top: 1rpx solid #eee;
  gap: 20rpx;
  position: relative;
  z-index: 1001;
  background: #fff;
}

.submit-btn {
  background: #1AAD19;
  color: #fff;
  border: none;
  height: 70rpx;
  width: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  border-radius: 35rpx;
  margin: 0;
}

.cancel-btn {
  background: #f5f5f5;
  color: #666;
  border: none;
  height: 70rpx;
  width: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  border-radius: 35rpx;
  margin: 0;
}

.desc-picker {
  width: 100%;
}

.picker-content {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #eee;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: #f8f8f8;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
}

.picker-placeholder {
  color: #999;
}

.picker-arrow {
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-top: 12rpx solid #999;
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
}

.custom-select {
  position: relative;
  width: 100%;
}

.select-trigger {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #eee;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: #f8f8f8;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
}

.select-placeholder {
  color: #999;
}

.select-arrow {
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-top: 12rpx solid #999;
  transition: transform 0.3s;
}

.select-dropdown {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  background: #fff;
  border: 2rpx solid #eee;
  border-top: none;
  border-radius: 0 0 10rpx 10rpx;
  height: 0;
  overflow: hidden;
  transition: height 0.3s;
  z-index: 1003;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
}

.select-dropdown.show {
  height: 400rpx;
}

.select-options-scroll {
  height: 400rpx;
}

.select-options-scroll::-webkit-scrollbar {
  width: 8rpx;
  background: transparent;
}

.select-options-scroll::-webkit-scrollbar-thumb {
  background: #ccc;
  border-radius: 4rpx;
}

.select-option {
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333;
  height: 80rpx;
  line-height: 80rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

.select-option.selected {
  background: #f0f0f0;
  color: #1AAD19;
}

.select-option:active {
  background: #f5f5f5;
}

.select-dropdown.show .select-arrow {
  transform: rotate(180deg);
} 
